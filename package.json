{
  "name": "bg3-toolkit",
  "displayName": "bg3-toolkit",
  "description": "",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/khbsd/bg3-toolkit"
  },
  "engines": {
    "vscode": "^1.126.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bg3-toolkit.hrtRemind",
        "title": "secret :3"
      },
      {
        "command": "bg3-toolkit.packMod",
        "title": "pack mod"
      },
      {
        "command": "bg3-toolkit.lsxConvert",
        "title": "Convert this .lsx file to .lsf binary format"
      },
      {
        "command": "bg3-toolkit.lsfConvert",
        "title": "Convert this .lsf binary format file to .lsx"
      },
      {
        "command": "bg3-toolkit.xmlConvert",
        "title": "Convert this .xml file to .loca"
      },
      {
        "command": "bg3-toolkit.locaConvert",
        "title": "Convert this .loca file to .xml"
      },
      {
        "command": "bg3-toolkit.unpackMod",
        "title": "Unpack this mod into its current folder"
      },
      {
        "command": "bg3-toolkit.lsxConvertAll",
        "title": "Convert all .lsx files to .lsf binary format"
      },
      {
        "command": "bg3-toolkit.lsfConvertAll",
        "title": "Convert all .lsf binary format files to .lsx"
      },
      {
        "command": "bg3-toolkit.xmlConvertAll",
        "title": "Convert all .xml files to .loca"
      },
      {
        "command": "bg3-toolkit.locaConvertAll",
        "title": "Convert all .loca files to .xml"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname == .lsx || resourceExtname == .LSX",
          "command": "bg3-toolkit.lsxConvert"
        },
        {
          "when": "resourceExtname == .lsf || resourceExtname == .LSF || resourceExtname == .lsb ||  resourceExtname == .LSB || resourceExtname == .lsfx || resourceExtname == .LSFX || resourceExtname == .lsfex || resourceExtname == .LSFEX || resourceExtname == .lsbc || resourceExtname == .LSBC || resourceExtname == .lsbs || resourceExtname == .LSBS ",
          "command": "bg3-toolkit.lsfConvert"
        },
        {
          "when": "resourceExtname == .xml || resourceExtname == .XML",
          "command": "bg3-toolkit.xmlConvert"
        },
        {
          "when": "resourceExtname == .loca || resourceExtname == .LOCA",
          "command": "bg3-toolkit.locaConvert"
        },
        {
          "when": "resourceExtname == .pak || resourceExtname == .PAK",
          "command": "bg3-toolkit.unpackMod"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bg3-toolkit",
          "title": "bg3 toolkit",
          "icon": "resources/icon/icon.svg"
        }
      ]
    },
    "views": {
      "bg3-toolkit": [
        {
          "type": "webview",
          "icon": "",
          "id": "toolkitWebviewView",
          "name": "toolkit"
        },
        {
          "icon": "",
          "id": "toolkitTreeWorkspace",
          "name": "workspace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "toolkitTree",
        "contents": "hi!! i love you.\n[click me plz i need it](command:bg3-toolkit.hrtRemind)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.126.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.10.0",
    "typescript": ">=4.8.4 <6.1.0",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "larian-formats-wasm": "^0.9.3"
  }
}
