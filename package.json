{
  "name": "bg3-toolkit",
  "displayName": "bg3-toolkit",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.126.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished", "onView:toolkitTree"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bg3-toolkit.helloWorld",
        "title": "Hello World"
      }
    ],
    "views": {
      "bg3-toolkit": [
        {
          "icon": "",
          "id": "toolkitTree",
          "name": "bg3 toolkit"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bg3-toolkit",
          "title": "bg3 toolkit",
          "icon": "resources/icon/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.126.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
